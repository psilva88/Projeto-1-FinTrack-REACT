        },
        {
          "name": "Excluir usuário (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "{{usuarioId}}"
              ]
            },
            "description": "200 OK. Restrito a administradores."
          }
        }
      ],
      "description": "Gestão de usuários. Listar e excluir são restritos a administradores."
