            "description": "200 OK. Apenas o próprio usuário ou um admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Nome Atualizado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
